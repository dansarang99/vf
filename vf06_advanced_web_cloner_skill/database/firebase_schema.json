{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MA JI YOUNG Edition & Atelier Firebase Firestore Schema",
  "version": "1.0.0",
  "collections": {
    "users": {
      "description": "Registered collectors and gallery members",
      "fields": {
        "uid": { "type": "string", "description": "Firebase Auth UID or local unique ID" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "tier": { "type": "string", "enum": ["collector", "vip", "partner"], "default": "collector" },
        "role": { "type": "string", "enum": ["user", "admin"], "default": "user" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "carts": {
      "description": "User shopping carts with real-time persistent item list",
      "fields": {
        "uid": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artwork_id": { "type": "string" },
              "code": { "type": "string" },
              "title": { "type": "string" },
              "price": { "type": "number", "multipleOf": 10000 },
              "quantity": { "type": "integer", "minimum": 1 },
              "size": { "type": "string" },
              "medium": { "type": "string" },
              "image": { "type": "string" }
            }
          }
        },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "orders": {
      "description": "Executed artwork purchase orders and collector acquisition records",
      "fields": {
        "order_id": { "type": "string", "pattern": "^ORD-2026-[0-9]{5,6}$" },
        "uid": { "type": "string" },
        "user_name": { "type": "string" },
        "user_email": { "type": "string" },
        "user_phone": { "type": "string" },
        "shipping_address": { "type": "string" },
        "delivery_note": { "type": "string" },
        "items": { "type": "array" },
        "subtotal_amount": { "type": "number", "multipleOf": 10000 },
        "shipping_fee": { "type": "number", "default": 0 },
        "total_amount": { "type": "number", "multipleOf": 10000 },
        "payment_method": { 
          "type": "string", 
          "enum": ["credit_card", "bank_transfer", "virtual_account", "gallery_invoice"] 
        },
        "payment_status": { "type": "string", "enum": ["paid", "pending", "refunded"], "default": "paid" },
        "order_status": { 
          "type": "string", 
          "enum": ["결제완료", "작품검수중", "프라이빗배송준비", "배송중", "소장인도완료"], 
          "default": "결제완료" 
        },
        "warranty_number": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "inquiries": {
      "description": "Artwork viewing inquiries and collector consultation requests",
      "fields": {
        "id": { "type": "string" },
        "artwork_id": { "type": "string" },
        "artwork_code": { "type": "string" },
        "artwork_title": { "type": "string" },
        "client_name": { "type": "string" },
        "client_phone": { "type": "string" },
        "client_email": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["신규", "연락완료", "상담중", "소장확정"], "default": "신규" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
